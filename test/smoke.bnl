import "onnxruntime-bnlang" as ort;

print("== onnxruntime-bnlang ==");
print("version          :", ort.version);
print("providers        :", ort.providers());
print("InferenceSession :", ort.InferenceSession);
print("session_open     :", ort.session_open);
print("tensor_to_data   :", ort.tensor_to_data);

print();
print("To run a model:");
print();
print("  var sess = ort.InferenceSession.open(\"./model.onnx\", {});");
print("  var out  = sess.run({ \"input\": {dtype: \"float32\", shape: [1,3], data: [1,2,3]} });");
print("  print(ort.tensor_to_data(out[\"output\"][\"handle\"]));");
print("  sess.close();");
